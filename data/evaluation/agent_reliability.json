{
  "notes": "Held-out questions and oracle plans are evaluation-only, never imported by the production agent. No expected business result is supplied to the model.",
  "cases": [
    {
      "id": "B01",
      "question": "Compare supplier 2's observed on-time delivery with its own applicable agreement and procurement escalation procedure.",
      "calls": [
        {
          "tool": "get_supplier_performance",
          "arguments": {
            "supplier_id": 2
          }
        },
        {
          "tool": "search_corporate_knowledge",
          "arguments": {
            "query": "NS-CON-002",
            "filters": {
              "supplier_id": 2
            }
          }
        },
        {
          "tool": "search_corporate_knowledge",
          "arguments": {
            "query": "Procurement procedure",
            "filters": {
              "document_type": "policy"
            }
          }
        }
      ],
      "expected_codes": [
        "CON-002",
        "POL-001"
      ],
      "metric_checks": [
        {
          "tool": "get_supplier_performance",
          "path": "/metrics/on_time_rate"
        },
        {
          "tool": "get_supplier_performance",
          "path": "/contracts/0/target_percent"
        }
      ],
      "required_entities": {
        "supplier": [
          2
        ]
      }
    },
    {
      "id": "B02",
      "question": "List the three suppliers with the lowest observed on-time rate as of the end of June, preserving their observation volumes.",
      "as_of": "2026-06-30",
      "calls": [
        {
          "tool": "compare_suppliers",
          "arguments": {
            "sort": "on_time_rate",
            "direction": "asc",
            "limit": 3
          }
        }
      ],
      "ranking": {
        "sort": "on_time_rate",
        "direction": "asc",
        "minimum_rows": 3
      }
    },
    {
      "id": "B03",
      "question": "Which three suppliers carry the largest overdue purchase commitments in GBP? This is about exposure rather than delivery-rate ranking.",
      "calls": [
        {
          "tool": "compare_suppliers",
          "arguments": {
            "sort": "overdue_commitment",
            "direction": "desc",
            "limit": 3
          }
        }
      ],
      "ranking": {
        "sort": "overdue_commitment",
        "direction": "desc",
        "minimum_rows": 3
      }
    },
    {
      "id": "B04",
      "question": "Compare the three suppliers with the highest number of overdue outstanding purchase orders.",
      "calls": [
        {
          "tool": "compare_suppliers",
          "arguments": {
            "sort": "overdue_outstanding_orders",
            "direction": "desc",
            "limit": 3
          }
        }
      ],
      "ranking": {
        "sort": "overdue_outstanding_orders",
        "direction": "desc",
        "minimum_rows": 3
      }
    },
