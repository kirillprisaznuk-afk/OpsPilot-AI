# Fresh Windows checkout: run scripts/opspilot.ps1 Setup. It creates .env itself.
# Manual configuration reference. Replace placeholders and keep .env out of Git.
COMPOSE_PROJECT_NAME=opspilot-stage1
OPSPILOT_WEB_PORT=3106
OPSPILOT_API_PORT=8001
OPSPILOT_DB_PORT=55432
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_PASSWORD
DATABASE_URL=postgresql+psycopg://opspilot:REPLACE_WITH_URL_ENCODED_PASSWORD@localhost:55432/opspilot
PYTHONPATH=backend;.
# Free Stage 4: local Ollama only. No key or account required.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OpenAI is optional and requires explicit LLM_PROVIDER=openai; never a fallback.
OPENAI_API_KEY=

# Local multi-round context accounting, within the existing hard maximum.
AGENT_USAGE_TOKENS=100000
# Stage 4B candidate profiles: enable explicitly for live acceptance evaluation.
OLLAMA_COMPACT_TRANSPORT=true
OLLAMA_REFERENCE_OUTPUT=false
OLLAMA_TOOL_SELECTION=false
# Empty means automatic allocation; forcing all GPU layers was not a proven gain.
OLLAMA_GPU_LAYERS=
# Optional profiled prompt batch. Blank retains the provider default.
OLLAMA_BATCH_TOKENS=

# Stage 4C: local-only interpretation; deterministic analytics remain available.
HYBRID_LLM_ENABLED=false
HYBRID_MODEL=qwen3.5:2b-q4_K_M
HYBRID_ALLOW_LEGACY=false
# Native API default; Compose supplies the read-only host heartbeat mount instead.
HYBRID_RESOURCE_FILE=.local-tools/hybrid/resources.json
HYBRID_MODEL_TIMEOUT_SECONDS=8
HYBRID_MAX_MODEL_CALLS=2

# Stage 5 bootstrap supplies a distinct restricted runtime login; never use the owner URL.
WORKFLOW_DATABASE_URL=
WORKFLOW_DB_USER=opspilot_wf_app
WORKFLOW_DB_PASSWORD=
WORKFLOW_SESSION_HOURS=4
